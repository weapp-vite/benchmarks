<view class="page">
  <view class="toolbar">
    <view class="title">vue-mini core</view>
    <view class="summary">{{ summary }}</view>
    <button size="mini" bindtap="runBenchmark">Run</button>
  </view>
  <view class="metrics">
    <view wx:for="{{ metrics }}" wx:key="name" class="metric">
      <text>{{ item.name }}</text>
      <text>{{ item.durationMs }}ms</text>
      <text>{{ item.count }}</text>
    </view>
  </view>
  <view class="groups">
    <view wx:for="{{ groups }}" wx:key="group" class="group">
      <text>g{{ item.group }}</text>
      <text>{{ item.count }}</text>
      <text>{{ item.activeCount }}</text>
      <text>{{ item.totalScore }}</text>
    </view>
  </view>
  <view class="list">
    <view
      wx:for="{{ visibleItems }}"
      wx:key="id"
      class="row"
      data-id="{{ item.id }}"
      data-score="{{ item.score }}"
      bindtap="goDetail"
    >
      <text class="row__title">{{ item.title }}</text>
      <text>g{{ item.group }}</text>
      <text>{{ item.score }}</text>
    </view>
  </view>
</view>
