<template>
  <view class="page">
    <view class="toolbar">
      <view class="title">mpx</view>
      <view class="summary">{{ summary }}</view>
      <button size="mini" bindtap="runBenchmark">Run</button>
    </view>
    <view class="metrics">
      <view wx:for="{{ metrics }}" wx:key="name" class="metric">
        <text>{{ item.name }}</text>
        <text>{{ item.durationMs }}ms</text>
        <text>{{ item.count }}</text>
      </view>
    </view>
    <view class="groups">
      <view wx:for="{{ groups }}" wx:key="group" class="group">
        <text>g{{ item.group }}</text>
        <text>{{ item.count }}</text>
        <text>{{ item.activeCount }}</text>
        <text>{{ item.totalScore }}</text>
      </view>
    </view>
    <view class="list">
      <view
        wx:for="{{ visibleItems }}"
        wx:key="id"
        class="row"
        data-id="{{ item.id }}"
        data-score="{{ item.score }}"
        bindtap="goDetail"
      >
        <text class="row__title">{{ item.title }}</text>
        <text>g{{ item.group }}</text>
        <text>{{ item.score }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import {
  batchCount,
  checksum,
  createItems,
  filterActiveHighScore,
  groupChecksum,
  groupItems,
  initialCount,
  now,
  replaceCount,
  sliceWindow,
  sortByScoreThenId,
  stressCycles,
  updateEveryNth,
} from '../shared/benchmark'

createPage({
  data: {
    items: createItems(),
    visibleItems: createItems(),
    groups: [],
    metrics: [],
    summary: `${initialCount}/${initialCount}`,
  },
  onLoad() {
    this.runBenchmark()
  },
  methods: {
    record(name, start, list) {
      this.metrics = [
        ...this.metrics,
        {
          name,
          durationMs: now() - start,
          count: list.length,
          checksum: checksum(list),
        },
      ]
    },
    recordGroups(name, start, list) {
      this.metrics = [
        ...this.metrics,
        {
          name,
          durationMs: now() - start,
          count: list.length,
          checksum: groupChecksum(list),
        },
      ]
    },
    renderTick() {
      return new Promise((resolve) => {
        this.setData({}, resolve)
      })
    },
    async runBenchmark() {
      this.metrics = []
      this.groups = []
      let start = now()
      for (let index = 0; index < stressCycles.initialRender; index += 1) {
        this.items = createItems(initialCount, index * 10000)
        this.visibleItems = this.items
        this.groups = []
        this.summary = `${this.visibleItems.length}/${this.items.length}`
        await this.renderTick()
      }
      this.record('initial-render', start, this.visibleItems)

      start = now()
      for (let index = 0; index < stressCycles.appendBatch; index += 1) {
        this.items = [...this.items, ...createItems(batchCount, this.items.length)]
        this.visibleItems = this.items
        this.summary = `${this.visibleItems.length}/${this.items.length}`
        await this.renderTick()
      }
      this.record('append-batch', start, this.visibleItems)

      start = now()
      for (let index = 0; index < stressCycles.updateEveryNth; index += 1) {
        this.items = updateEveryNth(this.items, 3 + (index % 5))
        this.visibleItems = this.items
        this.summary = `${this.visibleItems.length}/${this.items.length}`
        await this.renderTick()
      }
      this.record('update-every-5th', start, this.visibleItems)

      start = now()
      for (let index = 0; index < stressCycles.sortScoreDesc; index += 1) {
        const sortedItems = sortByScoreThenId(this.items)
        this.visibleItems = index % 2 === 0 ? sortedItems : sortedItems.reverse()
        this.summary = `${this.visibleItems.length}/${this.items.length}`
        await this.renderTick()
      }
      this.record('sort-score-desc', start, this.visibleItems)

      start = now()
      for (let index = 0; index < stressCycles.filterActiveHighScore; index += 1) {
        this.visibleItems = index % 2 === 0 ? filterActiveHighScore(this.items) : this.items
        this.summary = `${this.visibleItems.length}/${this.items.length}`
        await this.renderTick()
      }
      this.record('filter-active-high-score', start, this.visibleItems)

      start = now()
      for (let index = 0; index < stressCycles.groupAggregate; index += 1) {
        this.groups = groupItems(this.items)
        await this.renderTick()
      }
      this.recordGroups('group-aggregate-render', start, this.groups)

      start = now()
      for (let index = 0; index < stressCycles.windowSlice; index += 1) {
        this.visibleItems = sliceWindow(this.items, index * 53)
        this.summary = `${this.visibleItems.length}/${this.items.length}`
        await this.renderTick()
      }
      this.record('window-slice-middle', start, this.visibleItems)

      start = now()
      for (let index = 0; index < stressCycles.replaceDataset; index += 1) {
        this.items = createItems(replaceCount, 100000 + index * replaceCount)
        this.visibleItems = this.items
        this.groups = []
        this.summary = `${this.visibleItems.length}/${this.items.length}`
        await this.renderTick()
      }
      this.record('replace-dataset', start, this.visibleItems)

      console.log('BENCHMARK_RUNTIME', {
        framework: 'mpx',
        metrics: this.metrics,
      })
    },
    goDetail(event) {
      const { id, score } = event.currentTarget.dataset
      wx.navigateTo({
        url: `/pages/detail?id=${id}&score=${score}`,
      })
    },
  },
})
</script>

<script type="application/json">
{
  "navigationBarTitleText": "mpx"
}
</script>

<style>
.page {
  min-height: 100vh;
  padding: 24rpx;
}

.toolbar,
.metric,
.group,
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toolbar {
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #d1d5db;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
}

.summary {
  color: #2563eb;
}

.metrics {
  margin: 20rpx 0;
}

.metric,
.group,
.row {
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
}

.row__title {
  width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
</style>
