    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tarojs/cli": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@vitejs/plugin-vue": "4.6.2",
    "@vitejs/plugin-vue-jsx": "3.1.0",
    "@vue/compiler-sfc": "^3.5.42",
    "typescript": "^6.0.3",
    "vite": "^4.5.14",
    "vue-tsc": "^3.3.11"
