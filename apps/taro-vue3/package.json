{
  "name": "@benchmarks/taro-vue3",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm run build:weapp",
    "build:weapp": "taro build --type weapp",
    "dev": "taro build --type weapp --watch",
