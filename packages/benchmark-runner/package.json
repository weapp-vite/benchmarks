{
  "name": "@benchmarks/runner",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "bench": "pnpm run bench:compile && pnpm run bench:runtime && pnpm run bench:hmr",
    "bench:compile": "tsx src/compile.ts",
    "bench:hmr": "tsx src/hmr.ts",
    "bench:runtime": "tsx src/runtime.ts",
    "bench:size:wevu": "tsx src/size/wevu.ts",
    "build": "tsdown",
    "lint": "eslint .",
    "report:dashboard": "tsx src/dashboard/generate.ts",
    "report:refresh": "tsx src/dashboard/refresh.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "bench:compile:methods": "tsx src/compile/methods.ts"
  },
  "dependencies": {
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@weapp-vite/miniprogram-automator": "1.2.23",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsdown": "0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "~5.0.3"
  }
}
