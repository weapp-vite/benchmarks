{
  "name": "@benchmarks/runner",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "bench": "pnpm run bench:compile && pnpm run bench:runtime && pnpm run bench:hmr",
    "bench:compile": "tsx src/compile.ts",
    "bench:hmr": "tsx src/hmr.ts",
    "bench:runtime": "tsx src/runtime.ts",
    "bench:size:wevu": "tsx src/size/wevu.ts",
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@weapp-vite/miniprogram-automator": "1.1.3",
    "tsdown": "0.22.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
